{
  "name": "torana",
  "version": "2.0.0-rc.2",
  "description": "Open-source multi-platform gateway for agent runtimes, with Telegram and authenticated Buzz endpoints.",
  "license": "MIT",
  "author": "Jason Butterfield <jbutterfield@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jvbutterfield/torana.git"
  },
  "bugs": {
    "url": "https://github.com/jvbutterfield/torana/issues"
  },
  "homepage": "https://github.com/jvbutterfield/torana#readme",
  "keywords": [
    "telegram",
    "buzz",
    "nostr",
    "bot",
    "gateway",
    "agent",
    "claude",
    "llm",
    "ai"
  ],
  "type": "module",
  "workspaces": [
    "spike/buzz-transport"
  ],
  "overrides": {
    "brace-expansion": "1.1.18"
  },
  "bin": {
    "torana": "dist/cli.js"
  },
  "main": "dist/main.js",
  "files": [
    "dist/",
    "skills/",
    "codex-plugin/",
    "examples/side-session-runner/",
    "scripts/install-skills.ts",
    "scripts/check-skill-parity.ts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "start": "bun run src/cli.ts start",
    "typecheck": "bun x tsc --noEmit",
    "test": "bun test",
    "lint": "bun x eslint src",
    "format": "bun x prettier --write .",
    "format:check": "bun x prettier --check .",
    "build": "bun run scripts/build.ts",
    "prepublishOnly": "bun run typecheck && bun run test && bun run build"
  },
  "dependencies": {
    "@noble/curves": "2.0.1",
    "@noble/hashes": "2.0.1",
    "js-yaml": "^4.3.1",
    "nostr-tools": "2.24.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/js-yaml": "^4.0.9",
    "bun-types": "^1.3.12",
    "eslint": "^9.0.0",
    "prettier": "3.8.3",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0"
  }
}
